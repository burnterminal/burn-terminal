# Netlify → Site configuration → Environment variables

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...     # secret key (or legacy service_role), server only

# X Developer Console → your app → Keys and tokens → Consumer Key (OAuth 1.0a) → Regenerate
# "Sign in with X" over OAuth 1.0a is free: it makes no paid X API reads.
X_CONSUMER_KEY=
X_CONSUMER_SECRET=

# Alchemy → dashboard.alchemy.com → app with Solana Mainnet enabled → API Key. Secret.
ALCHEMY_API_KEY=

# Solana burn address (base58, exactly as is: it's case-sensitive). Shown on the site and checked by the server.
DEAD_ADDRESS=

# Any long random string (signs login cookies)
SESSION_SECRET=

# Optional
SITE_URL=https://your-site.netlify.app      # if you use a custom domain, put it here
CAMPAIGN_START=2026-10-07T00:00:00Z         # sends before this don't count
ALLOW_MANUAL_HANDLE=false                   # true = sign in by typing a handle (testing only!)
EXCLUDE_SYMBOLS=SOL,WSOL,USDC,USDT,PYUSD,USDS,USDG,BURN   # tickers that never count
# EXCLUDE_MINTS=So111…112,EPjF…Dt1v,…                    # mints that never count (wSOL, USDC, USDT, PYUSD by default)
# MAX_TX_SCAN=300                                       # newest transactions per wallet to look through
